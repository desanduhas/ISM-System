# Supabase - get from Supabase Dashboard -> Project Settings -> API / Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_or_service_role_key
SUPABASE_SECRET_KEY=your_supabase_secret_or_service_role_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Meta WhatsApp Cloud API (optional during development; mock delivery logs run if omitted)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_GRAPH_API_VERSION=v27.0
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
