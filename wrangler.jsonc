{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ism-system",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "build": {
    "command": "npm run build:worker -- --skipNextBuild"
  }
}
